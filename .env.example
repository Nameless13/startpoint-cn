# ═══════════════════════════════════════════════════════════════════════
# 通用配置（两种部署方式共用）
# ═══════════════════════════════════════════════════════════════════════

# CDN 资源目录，相对于项目根目录
CDN_DIR=".cdn"

# 每日/每周复位时间（服务端时间的小时，0-23）
DAILY_RESET_HOUR=5

# CN CDN 资源版本号，必须和客户端 resourceVersion 一致
CN_RES_VERSION="1.4.54"

# 战斗掉落倍数：正常为 1；测试时可调高（如 10）加速掉落
DROP_MULTIPLIER=1

# 结算严格模式：默认关闭。关闭时，若 /single_battle_quest/finish 找不到开战登记
# （服务端重启、多进程部署、或客户端没调 /start），服务端按请求体里的关卡重建一份最小
# 登记继续结算，避免 400 "No active quest to finish."。开启则恢复旧行为（仅接受内存/
# 数据库里的登记），代价是上述情况下玩家打完无法结算。
# QUEST_FINISH_STRICT="true"

# ═══════════════════════════════════════════════════════════════════════
# 本机安全部署（默认）
# ═══════════════════════════════════════════════════════════════════════
# cp .env.example .env 后开箱即用：仅监听本机 127.0.0.1，管理面走下面的
# 「无令牌 loopback」模式，不用先生成令牌也能起服务。
# 若客户端在另一台设备，把 CN_LISTEN_HOST/CDN_BASE_URL 改为本机 LAN IP —
# 那一步必须同时改用 CN_ADMIN_TOKEN，否则服务端会直接拒绝启动（见下）。

# CN 服务端 HTTP 监听地址与端口
CN_LISTEN_HOST="127.0.0.1"          # 默认仅本机；LAN 监听必须配置强管理令牌
CN_LISTEN_PORT="8001"               # HTTP API + Web 管理面板 + CDN 资源

# ───────────────────────────────────────────────────────────────────────
# ⚠ 管理面鉴权：默认是「无令牌 loopback」模式 —— 管理面完全不校验身份
# ───────────────────────────────────────────────────────────────────────
# 生效条件：CN_LISTEN_HOST 必须是回环地址（127.x.x.x / localhost / ::1）。
#   写成 LAN IP 或 0.0.0.0 时本开关无效，服务端启动即报错
#   "CN_ADMIN_TOKEN is required for non-loopback CN_LISTEN_HOST"。
# 生效范围：只看启动时的监听地址，不校验单个请求的来源。也就是说，凡是能
#   连上这个端口的都能进管理面 —— 一旦用 nginx 反代、端口转发（含把 8001
#   转发进容器/虚拟机/别的主机）把它暴露出去，管理面等于裸奔。
# 绑 LAN / 公网前必须：启用下面的 CN_ADMIN_TOKEN（≥32 UTF-8 字节，短于此
#   服务端拒绝启动；scripts/generate-admin-token.ps1 会生成随机令牌并只写
#   本地 .env），并把本行改回 false 或删除。
#   （配了合法令牌后就走令牌模式、本行自动失效；改掉它只是防止以后把监听
#   地址改回本机时又静默退回不鉴权。）
CN_ADMIN_ALLOW_INSECURE_LOOPBACK="true"

# 对外开服（LAN/公网）时启用这条，同时关掉上面那条 insecure 开关。
# 两个服务入口共用；脚本生成至少 32 字节随机令牌并只写本地 .env：
# CN_ADMIN_TOKEN="generated-by-scripts/generate-admin-token.ps1"
# 管理页面经 HTTPS 访问时启用：
# CN_ADMIN_COOKIE_SECURE="true"

# 全局服（国际服 Kakao 版本，一般不使用）
LISTEN_HOST="localhost"             # 全局服 HTTP 监听地址
LISTEN_PORT="8000"                  # 全局服 HTTP 端口

# CDN 客户端下载 URL
# 同机测试用 127.0.0.1；局域网其他设备用你的 LAN IP
CDN_BASE_URL="http://127.0.0.1:8001/patch/cn"

# 客户端更新图的受支持起点（full 包版本会由服务自动加入）
CN_SUPPORTED_ASSET_BASES="1.4.102,1.4.133"

# ═══════════════════════════════════════════════════════════════════════
# 公网部署（云服务器）— 部署时取消下面注释，并填入实际值
# ═══════════════════════════════════════════════════════════════════════
# 详细步骤见 docs/deployment.md（nginx 反向代理 + 防火墙 + SSL）

# CN_LISTEN_HOST="127.0.0.1"                        # 仅监听本地，由 nginx 作为公网入口
# CDN_BASE_URL="https://<YOUR_DOMAIN>/patch/cn"     # 公网域名 + HTTPS
# SESSION_PUBLIC_HOST="<YOUR_DOMAIN>"               # 联机 TCP 房间的公网显示地址
# CN_PUBLIC_HOST="<YOUR_DOMAIN>"                    # 联机 TCP 房间的公网显示地址（回退）
# 联机 TCP 需要公网监听，SESSION_HOST="0.0.0.0" 已在下方的联机区块设置

# ═══════════════════════════════════════════════════════════════════════
# 联机 TCP 会话服务器（cooperation_room + cooperation_battle）
# ═══════════════════════════════════════════════════════════════════════

SESSION_PORT="8003"                 # TCP 监听端口
SESSION_HOST="0.0.0.0"              # 联机 TCP 需要监听公网；公网部署通过 nginx stream TLS 代理

# 联机房间自动清理（单位：毫秒）
# MULTI_ROOM_INCOMPLETE_EXPIRY_MS=900000     # 未满 3 人房间过期时间（默认 15 分钟）
# MULTI_ROOM_FULL_EXPIRY_MS=1800000          # 满 3 人房间过期时间（默认 30 分钟）
# MULTI_ROOM_CLEAN_INTERVAL_MS=60000         # 过期检查间隔（默认 60 秒）

# 联机 NPC 延迟（单位：毫秒）
# NPC_JOIN_DELAY_MS=2000                     # NPC 加入房间延迟（默认 2 秒）
# NPC_READY_DELAY_MS=500                     # NPC 准备延迟（默认 0.5 秒）
